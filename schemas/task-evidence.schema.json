{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MasterSkimo/browfield-discovery/blob/main/schemas/task-evidence.schema.json",
  "title": "Downstream implementation evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "request",
    "source_revision",
    "environment",
    "acceptance",
    "checks",
    "conclusion"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expectation",
          "implementation_paths",
          "test_ids",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          },
          "implementation_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "command",
          "result",
          "assertions",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "playwright",
              "newman",
              "other"
            ]
          },
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "executed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_failures",
        "regressions"
      ],
      "properties": {
        "known_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "not_verified",
            "incomplete"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
